# Public URL of the deployed site (used for metadata, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. A GitHub token raises the API rate limit (60 -> 5000 requests/hour)
# and enables the full-year contribution calendar. It is only read on the server.
# A fine-grained token with "Public repositories (read-only)" access is enough.
GITHUB_TOKEN=
